#!/usr/bin/env python3
"""
统一AI系统启动器
同时启动所有AI和红绿灯相关模块
"""

import os
import sys
import time
import signal
import subprocess
import threading
import json
from pathlib import Path
import logging

# 设置日志
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('/tmp/unified_launcher.log'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger("UnifiedLauncher")

class UnifiedAILauncher:
    def __init__(self, base_path="/data/openpilot/openpilot_custom"):
        self.base_path = Path(base_path)
        self.processes = {}  # 进程字典
        self.running = False
        
        # 模块配置 - 按启动顺序排列
        self.modules = [
            {
                "name": "AI车速建议器",
                "file": "3_corolla_ai_speed_advisor.py",
                "port": 5580,
                "delay": 2,  # 启动后等待秒数
                "required": True,
                "depends_on": []  # 依赖的模块
            },
            {
                "name": "AI数据桥接器",
                "file": "ai_client.py",
                "port": None,
                "delay": 1,
                "required": False,
                "depends_on": ["3_corolla_ai_speed_advisor.py"]
            },
            {
                "name": "AI极简代理",
                "file": "simple_ai_proxy.py",
                "port": 8015,
                "delay": 1,
                "required": False,
                "depends_on": ["3_corolla_ai_speed_advisor.py"]
            },
            {
                "name": "红绿灯主控制器",
                "file": "1_traffic_light_safe.py",
                "port": 5555,
                "delay": 1,
                "required": True,
                "depends_on": ["3_corolla_ai_speed_advisor.py", "simple_ai_proxy.py"]
            },
            {
                "name": "红绿灯安全补丁",
                "file": "tl_safety_patch.py",  # 假设存在
                "port": 5556,
                "delay": 0,
                "required": False,
                "depends_on": ["1_traffic_light_safe.py"]
            }
        ]
        
        # 检查所有文件
        self.check_all_files()
        
        # 注册信号处理
        signal.signal(signal.SIGINT, self.signal_handler)
        signal.signal(signal.SIGTERM, self.signal_handler)
    
    def check_all_files(self):
        """检查所有需要的文件"""
        logger.info("🔍 检查文件系统...")
        
        missing_files = []
        for module in self.modules:
            file_path = self.base_path / module["file"]
            if not file_path.exists():
                missing_files.append(module["file"])
                logger.warning(f"⚠️ 文件不存在: {module['file']}")
            else:
                logger.info(f"✅ 文件存在: {module['file']}")
        
        if missing_files:
            logger.warning(f"总计缺失 {len(missing_files)} 个文件: {', '.join(missing_files)}")
        
        return len(missing_files) == 0
    
    def start_module(self, module_config):
        """启动单个模块"""
        try:
            file_path = self.base_path / module_config["file"]
            
            if not file_path.exists():
                if module_config["required"]:
                    logger.error(f"❌ 必需模块文件不存在: {module_config['file']}")
                    return None
                else:
                    logger.warning(f"⚠️ 可选模块跳过: {module_config['file']}")
                    return None
            
            # 检查依赖
            for dep in module_config["depends_on"]:
                if dep in self.processes and self.processes[dep] is None:
                    logger.warning(f"⚠️ 模块 {module_config['name']} 缺少依赖: {dep}")
                    return None
            
            # 构建命令
            cmd = ["python3", str(file_path)]
            
            # 设置日志文件路径
            log_file = f"/tmp/{module_config['file'].replace('.py', '.log')}"
            
            # 启动进程
            with open(log_file, 'w') as f:
                process = subprocess.Popen(
                    cmd,
                    stdout=f,
                    stderr=subprocess.STDOUT,
                    cwd=str(self.base_path),
                    preexec_fn=os.setsid  # 创建新的进程组
                )
            
            pid = process.pid
            logger.info(f"✅ 启动: {module_config['name']} (PID: {pid}, 端口: {module_config.get('port', 'N/A')})")
            
            # 延迟等待
            if module_config["delay"] > 0:
                time.sleep(module_config["delay"])
            
            return {
                "process": process,
                "config": module_config,
                "start_time": time.time(),
                "log_file": log_file
            }
            
        except Exception as e:
            logger.error(f"❌ 启动模块 {module_config['name']} 失败: {e}")
            return None
    
    def start_all(self):
        """启动所有模块"""
        logger.info("=" * 60)
        logger.info("🚀 19款卡罗拉双擎AI系统 - 统一启动")
        logger.info("=" * 60)
        logger.info("开始启动模块...")
        
        self.running = True
        
        # 按顺序启动所有模块
        for module in self.modules:
            if not self.running:
                break
            
            proc_info = self.start_module(module)
            if proc_info:
                self.processes[module["file"]] = proc_info
        
        logger.info("=" * 60)
        logger.info(f"✅ 已启动 {len(self.processes)} 个模块")
        
        # 启动监控线程
        self.monitor_thread = threading.Thread(target=self.monitor_all, daemon=True)
        self.monitor_thread.start()
        
        logger.info("📡 系统监控已启动")
        logger.info("=" * 60)
    
    def monitor_all(self):
        """监控所有进程"""
        while self.running:
            try:
                for filename, proc_info in list(self.processes.items()):
                    if not self.running:
                        break
                    
                    process = proc_info["process"]
                    name = proc_info["config"]["name"]
                    
                    # 检查进程状态
                    return_code = process.poll()
                    if return_code is not None:
                        logger.warning(f"⚠️ 进程已停止: {name} (返回码: {return_code})")
                        
                        # 如果系统仍在运行，尝试重启
                        if self.running and proc_info["config"]["required"]:
                            logger.info(f"🔄 尝试重启: {name}")
                            time.sleep(2)
                            
                            new_proc_info = self.start_module(proc_info["config"])
                            if new_proc_info:
                                self.processes[filename] = new_proc_info
                                logger.info(f"✅ 重启成功: {name}")
                            else:
                                logger.error(f"❌ 重启失败: {name}")
                                del self.processes[filename]
                        else:
                            del self.processes[filename]
                
                # 每分钟显示一次状态
                if int(time.time()) % 60 == 0:
                    self.show_status()
                
                time.sleep(5)  # 5秒检查一次
                
            except Exception as e:
                logger.error(f"监控异常: {e}")
                time.sleep(1)
    
    def show_status(self):
        """显示系统状态"""
        active_count = sum(1 for p in self.processes.values() if p["process"].poll() is None)
        logger.info(f"📊 系统状态: {active_count}/{len(self.processes)} 个进程运行中")
    
    def signal_handler(self, sig, frame):
        """信号处理"""
        logger.info(f"\n🛑 收到信号 {sig}，正在优雅关闭...")
        self.stop_all()
    
    def stop_all(self):
        """停止所有进程"""
        self.running = False
        
        logger.info("正在停止所有进程...")
        
        # 先停止子线程
        if hasattr(self, 'monitor_thread') and self.monitor_thread.is_alive():
            self.monitor_thread.join(timeout=5)
        
        # 停止所有进程（从后向前停止）
        for filename, proc_info in reversed(list(self.processes.items())):
            process = proc_info["process"]
            name = proc_info["config"]["name"]
            
            try:
                if process.poll() is None:  # 进程仍在运行
                    # 先尝试优雅停止
                    os.killpg(os.getpgid(process.pid), signal.SIGTERM)
                    
                    try:
                        process.wait(timeout=5)
                        logger.info(f"✅ 已停止: {name}")
                    except subprocess.TimeoutExpired:
                        # 强制终止
                        os.killpg(os.getpgid(process.pid), signal.SIGKILL)
                        logger.warning(f"⚠️ 强制终止: {name}")
                        
            except Exception as e:
                logger.error(f"停止进程 {name} 时出错: {e}")
        
        self.processes.clear()
        logger.info("🔴 系统已完全停止")
    
    def get_detailed_status(self):
        """获取详细状态"""
        status = {
            "running": self.running,
            "total_modules": len(self.modules),
            "running_modules": len(self.processes),
            "modules": []
        }
        
        for filename, proc_info in self.processes.items():
            process = proc_info["process"]
            config = proc_info["config"]
            
            status["modules"].append({
                "name": config["name"],
                "filename": config["file"],
                "pid": process.pid,
                "is_alive": process.poll() is None,
                "uptime": time.time() - proc_info["start_time"],
                "port": config.get("port"),
                "log_file": proc_info["log_file"]
            })
        
        return status

def main():
    """主函数"""
    print("=" * 60)
    print("19款卡罗拉双擎AI系统 - 统一启动器")
    print("=" * 60)
    print("启动时间:", time.strftime("%Y-%m-%d %H:%M:%S"))
    print("=" * 60)
    
    # 切换到正确目录
    try:
        os.chdir("/data/openpilot/openpilot_custom")
        print(f"工作目录: {os.getcwd()}")
    except Exception as e:
        print(f"⚠️ 无法切换目录: {e}")
        return
    
    # 创建启动器实例
    launcher = UnifiedAILauncher()
    
    try:
        # 启动系统
        launcher.start_all()
        
        print("\n📊 系统控制菜单:")
        print("  1. 查看详细状态")
        print("  2. 查看所有日志")
        print("  3. 重启特定模块")
        print("  4. 停止系统")
        print("  按 Ctrl+C 停止系统")
        print("-" * 40)
        
        # 简单的交互控制
        import select
        
        while launcher.running:
            # 检查是否有输入
            rlist, _, _ = select.select([sys.stdin], [], [], 1.0)
            
            if rlist:
                try:
                    user_input = sys.stdin.readline().strip()
                    
                    if user_input == "1":
                        status = launcher.get_detailed_status()
                        print("\n📈 详细状态:")
                        for module in status["modules"]:
                            status_text = "🟢 运行中" if module["is_alive"] else "🔴 已停止"
                            print(f"  {module['name']}: {status_text} (PID: {module['pid']}, 运行: {module['uptime']:.0f}秒)")
                    
                    elif user_input == "2":
                        print("\n📄 日志文件:")
                        for filename, proc_info in launcher.processes.items():
                            print(f"  {proc_info['config']['name']}: {proc_info['log_file']}")
                    
                    elif user_input == "4":
                        print("\n🛑 手动停止系统...")
                        break
                        
                except Exception as e:
                    print(f"输入处理错误: {e}")
        
    except KeyboardInterrupt:
        print("\n🛑 用户中断")
    except Exception as e:
        logger.error(f"主程序异常: {e}")
    finally:
        launc
